{"nodes": [{"id": "reports_mia_security_analysis_report_document", "label": "MIA Security Analysis Report (Revision 7)", "file_type": "document", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_mia_security_analysis_report_mia", "label": "Membership Inference Attack (MIA) against PubMedQA corpus", "file_type": "concept", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_mia_security_analysis_report_decision_match", "label": "decision_match signal (yes/no/maybe decision-commitment check)", "file_type": "rationale", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the sole production signal (weight 1.0) after a genuine dev/test split grid search found it, alone, generalizes best to unseen seeds (mean AUC 0.620, 95% CI excludes chance) while similarity/certainty/length_ratio added net noise rather than signal."}, {"id": "reports_mia_security_analysis_report_gated_composite", "label": "Gated 4-signal Composite Scoring Formula", "file_type": "concept", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_mia_security_analysis_report_revision7", "label": "Revision 7 \u2014 empirical weight re-tuning under train/test split", "file_type": "rationale", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revisions 5-6 diagnosed but never fixed the composite's unresolved held-out generalization; Revision 7 did a genuine dev/test seed split, grid-searched weights on 13 dev seeds, and locked weights before a single, honest evaluation on 5 fresh seeds -- avoiding the overfitting risk of re-using already-inspected seeds."}, {"id": "reports_mia_security_analysis_report_consistency_score", "label": "Multi-probe consistency score signal", "file_type": "rationale", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motivated by the idea that a member document (real backing passage) should produce more consistent repeated answers than a non-member guessed from parametric knowledge; the most promising but least-replicated lead (AUC 0.75/0.49/0.57 across 3 seeds), not yet folded into the production composite."}, {"id": "reports_mia_security_analysis_report_ablation_composite", "label": "Ablation composite (decision-dominant, sim/certainty zeroed)", "file_type": "concept", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_mia_security_analysis_report_obfuscate_decision_content", "label": "obfuscate_decision_content() content-level defense", "file_type": "rationale", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built because the earlier positional obfuscate_decision() only relocates the decision token past a fixed scan window rather than removing its content, which an adaptive full-response-scanning attacker defeats; this defense detects and rewrites the token itself, closing that gap and driving adaptive/semantic attacker AUC to exactly chance."}, {"id": "reports_mia_security_analysis_report_pubmedqa", "label": "PubMedQA (pqa_labeled) corpus", "file_type": "concept", "source_file": "reports/MIA_Security_Analysis_Report.md", "source_location": nu