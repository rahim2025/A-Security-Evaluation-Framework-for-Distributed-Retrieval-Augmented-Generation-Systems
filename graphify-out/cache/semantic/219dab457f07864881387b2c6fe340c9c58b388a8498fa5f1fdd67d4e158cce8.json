{"nodes": [{"id": "reports_kb_document", "label": "Knowledge-Base Extraction Attack & Defense Report", "file_type": "document", "source_file": "reports/kb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_kb_kb_extraction_attack", "label": "KB Extraction Attack (black-box API enumeration)", "file_type": "concept", "source_file": "reports/kb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_kb_query_diversity_throttle", "label": "QueryDiversityThrottle defense", "file_type": "rationale", "source_file": "reports/kb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A numeric-score-noise defense is architecturally inapplicable because /query returns raw document text with no score to perturb; the throttle instead observes topic diversity in a client's recent query window (a real, already-available signal) since a legitimate user's topic distribution should be far narrower than a systematic extractor's."}, {"id": "reports_kb_crr_metric", "label": "Chunk Recovery Rate (CRR) metric", "file_type": "concept", "source_file": "reports/kb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_kb_corpus_drift_bug", "label": "Corpus-drift configuration bug (sources_0.jsonl SQuAD to PubMedQA)", "file_type": "rationale", "source_file": "reports/kb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The attack script assumed sources_0.jsonl still held SQuAD content, an assumption invalidated when it was migrated to PubMedQA for the unrelated MIA fix; this silently made the entire attack 100% non-functional (crashed before sending a probe), which would have looked like 'the system is safe' to anyone reading only the crash, not the true untested state -- fixed by building ground truth per-source from each source's own real content."}, {"id": "reports_kb_topic_balance_sampling", "label": "Topic-balance / stratified probe sampling strategy", "file_type": "rationale", "source_file": "reports/kb.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A naive attacker repeating similar questions retrieves the same handful of documents; deliberately spreading probe selection across topics (stratified sampling) maximizes new coverage per query, since the retrieval oracle returns at most k=5 documents per call so coverage is bounded by how many distinct embedding-space regions are touched."}], "edges": [{"source": "reports_kb_document", "target": "reports_kb_kb_extraction_attack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/kb.md", "source_location": null, "weight": 1.0}, {"source": "reports_kb_kb_extraction_attack", "target": "reports_kb_topic_balance_sampling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/kb.md", "source_location": null, "weight": 1.0}, {"source": "reports_kb_document", "target": "reports_kb_query_diversity_throttle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/kb.md", "source_location": null, "weight": 1.0}, {"source": "reports_kb_document", "target": "reports_kb_crr_metric", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/kb.md", "source_location": null, "weight": 1.0}, {"source": "reports_kb_document", "target": "reports_kb_corpus_drift_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/kb.md", "source_location": null, "weight": 1.0}, {"source": "reports_kb_corpus_drift_bug", "target": "reports_mia_security_analysis_report_pubmedqa", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/kb.md", "source_location": null, "weight": 1.0}, {"source": "reports_kb_kb_extraction_attack", "target": "attack_kb_extraction_run_attack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/kb.md", "source_location": null, "weight": 1.0}, {"source": "reports_kb_query_diversity_throttle", "target": "defense_kb_extraction_defense_query_diversity_throttle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/kb.md", "source_location": null, "weight": 1.0}], "hyperedges": []}