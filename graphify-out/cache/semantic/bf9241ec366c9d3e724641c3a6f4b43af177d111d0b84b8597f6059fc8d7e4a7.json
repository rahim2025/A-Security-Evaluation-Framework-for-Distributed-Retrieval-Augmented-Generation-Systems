{"nodes": [{"id": "reports_sfa_security_analysis_report_document", "label": "SFA Security Analysis Report (selective_forward_sim module)", "file_type": "document", "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_sfa_security_analysis_report_sfa", "label": "Selective Forwarding Attack (gray-hole, simulation module)", "file_type": "concept", "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_sfa_security_analysis_report_ba_graph", "label": "Barabasi-Albert scale-free overlay simulation", "file_type": "rationale", "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used because real P2P overlays exhibit scale-free, hub-dominated degree distributions rather than uniform-random structure, so a mock network built this way inherits realistic hub-concentrated routing traffic that motivates degree-based (high_connectivity) targeting."}, {"id": "reports_sfa_security_analysis_report_ttl_bfs", "label": "TTL-bounded BFS query routing", "file_type": "concept", "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_sfa_security_analysis_report_ema_reputation", "label": "EMA-based peer reputation tracking", "file_type": "rationale", "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An exponential moving average weights recent behavior more heavily than a simple running mean, so it adapts faster to a peer's behavior changing (e.g. an attacker starting to drop only after establishing trust)."}, {"id": "reports_sfa_security_analysis_report_redundant_probe", "label": "Bounded redundant-probe fallback (Phase 2)", "file_type": "rationale", "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A TTL-bounded BFS that merely skips a known-blacklisted peer cannot manufacture a hop already spent discovering it; this bounded, capped fallback gives the router a small separate exploration budget so correct detection actually translates into a recovered answer under a tight hop budget, while remaining bounded (unlike the older sibling module's unbounded Phase-2 probe) to preserve research validity."}, {"id": "reports_sfa_security_analysis_report_high_connectivity", "label": "high_connectivity targeting strategy", "file_type": "concept", "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_sfa_security_analysis_report_rate_limit_fix", "label": "Live sweep rate-limit confounder diagnosis and fix (SS12.9)", "file_type": "rationale", "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live sweeps were silently rate-limited (HTTP 429 coerced into generic misses); root cause reproduced directly, client throttle+retry added, and error tracking broadened beyond 429s to a general error_total."}], "edges": [{"source": "reports_sfa_security_analysis_report_document", "target": "reports_sfa_security_analysis_report_sfa", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "weight": 1.0}, {"source": "reports_sfa_security_analysis_report_sfa", "target": "reports_sfa_security_analysis_report_ttl_bfs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "weight": 1.0}, {"source": "reports_sfa_security_analysis_report_sfa", "target": "reports_sfa_security_analysis_report_ba_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "weight": 1.0}, {"source": "reports_sfa_security_analysis_report_sfa", "target": "reports_sfa_security_analysis_report_high_connectivity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "weight": 1.0}, {"source": "reports_sfa_security_analysis_report_ema_reputation", "target": "reports_sfa_security_analysis_report_redundant_probe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "weight": 1.0}, {"source": "reports_sfa_security_analysis_report_sfa", "target": "attack_selective_forward_sim_selective_forwarding_attack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "weight": 1.0}, {"source": "reports_sfa_security_analysis_report_ema_reputation", "target": "defense_sfa_sim_defense_selective_forwarding_defense", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "weight": 1.0}, {"source": "reports_sfa_security_analysis_report_ba_graph", "target": "attack_selective_forward_sim_network_sim", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/SFA_Security_Analysis_Report.md", "source_location": null, "weight": 1.0}, {"sour